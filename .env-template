# =============================================================================
# Configuration Thezaurus — copier ce fichier en `.env` à la racine du projet :
#   cp .env-template .env
# Docker Compose lit automatiquement le `.env` situé à côté du docker-compose.yml.
# =============================================================================

# --- GOOGLE OAUTH (connexion des utilisateurs via NextAuth) ---
# Console GCP > APIs & Services > Credentials > OAuth 2.0 Client IDs.
# Le secret n'est affiché qu'à la création : utilisez "Add secret" si perdu.
# Vérifiez que http://localhost:3000/api/auth/callback/google figure dans les
# "Authorized redirect URIs" du client OAuth.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-oauth-client-secret

# --- NEXTAUTH (sessions côté front) ---
NEXTAUTH_URL=http://localhost:3000
# Chaîne aléatoire pour signer les JWT de session, à générer avec :
#   openssl rand -base64 32
NEXTAUTH_SECRET=your-generated-secret

# --- MODE FIRESTORE : ÉMULATEUR (dev, défaut) OU VRAI GCP (prod) ---
# Par défaut (rien à configurer) : émulateur Firestore local, données en RAM,
# aucun credential GCP requis.
# Pour basculer sur le vrai Firestore GCP, décommentez les 2 lignes ci-dessous
# (l'override docker-compose.prod.yml désactive l'émulateur et passe l'API en
# profil prod), et renseignez les variables GCP plus bas.
# ⚠️ Ne pas utiliser la base de prod en local.
# COMPOSE_PATH_SEPARATOR=:
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# --- FIRESTORE / GCP (utilisées uniquement en mode prod) ---
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
FIRESTORE_DATABASE_ID=thezaurus-dev
# Préfixe des collections (ex: dev, prod)
FIRESTORE_COLLECTION_PREFIX=dev

# --- CREDENTIALS GCP (uniquement en mode prod) ---
# En mode prod, l'API (conteneur Docker) se connecte au vrai Firestore via vos
# Application Default Credentials. Prérequis : gcloud CLI installé, puis :
#   gcloud auth application-default login
# GCLOUD_ADC = chemin du fichier ADC sur VOTRE machine (monté dans le conteneur).
#   - Linux/Mac : inutile de le définir (défaut: ~/.config/gcloud/application_default_credentials.json)
#   - Windows   : décommentez et adaptez la ligne ci-dessous (slashes AVANT, pas d'antislash)
# GCLOUD_ADC=C:/Users/VotreNom/AppData/Roaming/gcloud/application_default_credentials.json

# --- SLACK (optionnel) ---
# SLACK_APP_TOKEN=xapp-...
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_SIGNING_SECRET=...

# --- DÉPLOIEMENT CLOUD RUN (docker-compose.cloud.yml uniquement) ---
# URL publique du front déployé, utilisée comme NEXTAUTH_URL en prod.
# Pensez à l'ajouter aux Authorized redirect URIs du client OAuth
# (https://votre-url/api/auth/callback/google).
# NEXTAUTH_PUBLIC_URL=https://thezaurus.example.com
