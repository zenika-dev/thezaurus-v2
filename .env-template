# =============================================================================
# Configuration Thezaurus — copier ce fichier en `.env` à la racine du projet :
#   cp .env-template .env
# Docker Compose lit automatiquement le `.env` situé à côté du docker-compose.yml.
# =============================================================================

# --- GOOGLE OAUTH (connexion des utilisateurs via NextAuth) ---
# Console GCP > APIs & Services > Credentials > OAuth 2.0 Client IDs.
# Vérifiez que http://localhost:3000/api/auth/callback/google figure dans les "Authorized redirect URIs".
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-oauth-client-secret # Affiché uniquement à la création (Add secret si perdu)

# --- NEXTAUTH (sessions côté front) ---
NEXTAUTH_URL=http://localhost:3000
# THEZAURUS_PUBLIC_URL=https://thezaurus.example.com # URL absolue contractuelle pour les liens des mails (si omise: repli sur NEXTAUTH_PUBLIC_URL puis NEXTAUTH_URL)
NEXTAUTH_SECRET=your-generated-secret # Chaîne aléatoire pour signer les sessions (openssl rand -base64 32)

# --- MODE FIRESTORE : ÉMULATEUR (dev, défaut) OU VRAI GCP (prod) ---
# Par défaut (rien à configurer) : émulateur Firestore local, données en RAM, aucun credential GCP requis.
# Pour basculer sur le vrai Firestore GCP, décommentez les 2 lignes ci-dessous (l'override docker-compose.prod.yml
# désactive l'émulateur et passe l'API en profil prod), et renseignez les variables GCP plus bas.
# ⚠️ Ne pas utiliser la base de prod en local.
# COMPOSE_PATH_SEPARATOR=:
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# --- FIRESTORE / GCP (utilisées uniquement en mode prod) ---
GOOGLE_CLOUD_PROJECT_ID=thezaurus-494709
FIRESTORE_DATABASE_ID=thezaurus-dev
FIRESTORE_COLLECTION_PREFIX=dev # Préfixe des collections (ex: dev, prod)
GCP_REGION=europe-west1 # Région GCP par défaut

# --- CREDENTIALS GCP (uniquement en mode prod) ---
# En mode prod, l'API se connecte au vrai Firestore via vos Application Default Credentials (gcloud auth application-default login).
# GCLOUD_ADC = chemin du fichier ADC sur votre machine (Linux/Mac défaut: ~/.config/gcloud/application_default_credentials.json).
# GCLOUD_ADC=C:/path/to/application_default_credentials.json # Windows (slashes avant, pas d'antislash)

# --- SMTP & RAPPELS POST-TALK ---
# En mode DEV (défaut) : Mailpit capture les emails sur http://localhost:8025 avec les identifiants locaux ci-dessous.
# En mode PROD : renseigner les paramètres du serveur SMTP (ex: SendGrid, Mailgun) et une adresse SMTP_FROM autorisée.
MAILPIT_UI_PORT=8025 # Interface web Mailpit
MAILPIT_SMTP_PORT=1025 # Port SMTP hôte Mailpit
SMTP_HOST=mailpit # Hôte SMTP (mailpit en dev, hôte réel en prod)
SMTP_PORT=1025 # Port SMTP (1025 en dev, 587 pour STARTTLS en prod)
SMTP_FROM=thezaurus@local.test # Expéditeur des emails
SMTP_USERNAME=thezaurus # Identifiant SMTP (test Mailpit en dev, réel en prod)
SMTP_PASSWORD=thezaurus-local # Mot de passe SMTP
SMTP_LOGIN=REQUIRED # Mode d'authentification SMTP (NONE, REQUIRED, OPTIONAL)
SMTP_TLS=false # TLS direct (true/false)
SMTP_START_TLS=DISABLED # STARTTLS (DISABLED, REQUIRED, OPTIONAL)
SMTP_MOCK=false # false = envoi réel via SMTP ; true = simulation en mémoire Quarkus
FEEDBACK_REMINDER_ENABLED=true # Active le job quotidien d'envoi de rappels
FEEDBACK_REMINDER_CRON="0 0 9 * * ?" # Expression cron d'exécution (09:00 chaque jour)
FEEDBACK_REMINDER_TIME_ZONE=Europe/Paris # Fuseau horaire du cron

# --- SLACK (optionnel) ---
# SLACK_APP_TOKEN=xapp-...
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_SIGNING_SECRET=...

# --- DÉPLOIEMENT CLOUD RUN (docker-compose.cloud.yml uniquement) ---
# URL publique du front déployé, utilisée comme NEXTAUTH_URL en prod.
# Pensez à l'ajouter aux Authorized redirect URIs du client OAuth
# (https://votre-url/api/auth/callback/google).
# NEXTAUTH_PUBLIC_URL=https://thezaurus.example.com

# --- URL d'appel à l'agent talk ---
REASONING_ENGINE_URL=https://url_reel_d'appel_à_l'agent
