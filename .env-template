# =============================================================================
# Configuration Thezaurus — copier ce fichier en `.env` à la racine du projet :
#   cp .env-template .env
# Docker Compose lit automatiquement le `.env` situé à côté du docker-compose.yml.
# =============================================================================

# --- GOOGLE OAUTH (connexion des utilisateurs via NextAuth) ---
# Console GCP > APIs & Services > Credentials > OAuth 2.0 Client IDs.
# Le secret n'est affiché qu'à la création : utilisez "Add secret" si perdu.
# Vérifiez que http://localhost:3000/api/auth/callback/google figure dans les
# "Authorized redirect URIs" du client OAuth.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-oauth-client-secret

# --- NEXTAUTH (sessions côté front) ---
NEXTAUTH_URL=http://localhost:3000
# Chaîne aléatoire pour signer les JWT de session, à générer avec :
#   openssl rand -base64 32
NEXTAUTH_SECRET=your-generated-secret

# --- FIRESTORE / GCP ---
# En développement local avec Docker Compose, l'émulateur Firestore est utilisé par défaut.
GOOGLE_CLOUD_PROJECT_ID=thezaurus-494709
FIRESTORE_DATABASE_ID=thezaurus-dev
# Préfixe des collections (ex: dev)
FIRESTORE_COLLECTION_PREFIX=dev
# Région GCP par défaut
GCP_REGION=europe-west1

# --- SLACK (optionnel) ---
# SLACK_APP_TOKEN=xapp-...
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_SIGNING_SECRET=...

# --- DÉPLOIEMENT CLOUD RUN ---
# URL publique du front déployé, utilisée comme NEXTAUTH_URL en prod.
# Pensez à l'ajouter aux Authorized redirect URIs du client OAuth
# (https://votre-url/api/auth/callback/google).
# NEXTAUTH_PUBLIC_URL=https://thezaurus.example.com

# --- URL d'appel à l'agent talk ---
REASONING_ENGINE_URL=https://url_reel_d'appel_à_l'agent