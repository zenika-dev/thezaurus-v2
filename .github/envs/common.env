# Configuration commune à tous les environnements, lue par la CI (action .github/actions/load-env).
# Aucune valeur secrète ici : les secrets sont dans Secret Manager.
# Une clé redéfinie dans <env>.env remplace celle-ci (le dernier fichier lu l'emporte).
# Les noms doivent correspondre à infra/shared (comptes de service, WIF, registry).

GCP_PROJECT_ID=thezaurus-494709
GCP_REGION=europe-west1

# Images Docker : un seul registry, la même image est promue de staging à production
GCP_REGISTRY=europe-west1-docker.pkg.dev/thezaurus-494709/cloud-run-source-deploy

# Identités de la CI (WIF, sans clé JSON) et identité de l'app sur Cloud Run
WIF_PROVIDER=projects/176686532936/locations/global/workloadIdentityPools/github-actions-pool/providers/github-actions-oidc
WIF_SERVICE_ACCOUNT=thezurus-sa@thezaurus-494709.iam.gserviceaccount.com
WIF_AGENT_SERVICE_ACCOUNT=thezurus-agent-service-account@thezaurus-494709.iam.gserviceaccount.com
RUNTIME_SERVICE_ACCOUNT=thezurus-runtime-service-accou@thezaurus-494709.iam.gserviceaccount.com

# Client OAuth Google, partagé par tous les envs (chaque URL d'env est déclarée dans ses redirect URIs)
GOOGLE_CLIENT_ID=176686532936-0uk7jhf88468d1erme78jlqnkl7o8mb8.apps.googleusercontent.com

# Rappels post-talk : compte et audience du job Cloud Scheduler (infra/modules/environment/scheduler.tf)
SCHEDULER_SERVICE_ACCOUNT=thezaurus-scheduler-sa@thezaurus-494709.iam.gserviceaccount.com
FEEDBACK_REMINDER_AUDIENCE=thezaurus-feedback-reminder

# Emails via l'API HTTP Mailgun (la Sending Key est dans le secret partagé thezaurus-mailgun-sending-key)
MAILGUN_BASE_URL=https://api.eu.mailgun.net
MAILGUN_DOMAIN=m.zenika.com
SMTP_FROM=thezaurus-noreply@m.zenika.com

# Agent talks-agent (Agent Runtime), production uniquement.
# ID de l'instance Agent Engine (console Vertex AI → Agent Engine)
AGENT_ENGINE_ID=217923204625203200
TF_SERVICE_ACCOUNT=thezaurus-terraform-sa@thezaurus-494709.iam.gserviceaccount.com
TF_WIF_PROVIDER=projects/176686532936/locations/global/workloadIdentityPools/github-action-terraform/providers/github-oidc