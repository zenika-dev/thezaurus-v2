# Configuration de déploiement de la prod, lue par _deploy.yml.
# Aucune valeur secrète ici : les secrets sont dans Secret Manager (<SECRET_PREFIX>-*).
# Les noms doivent correspondre à infra/envs/prod/main.tf.
# ⚠️ Valeurs reprises des Repository variables : à vérifier une par une avant le premier déploiement.

GCP_PROJECT_ID=thezaurus-494709
GCP_REGION=europe-west1
SERVICE_NAME=thezaurus-v2

WIF_PROVIDER=projects/176686532936/locations/global/workloadIdentityPools/github-actions-pool/providers/github-actions-oidc
WIF_SERVICE_ACCOUNT=thezurus-sa@thezaurus-494709.iam.gserviceaccount.com
RUNTIME_SERVICE_ACCOUNT=thezurus-runtime-service-accou@thezaurus-494709.iam.gserviceaccount.com

# À copier depuis les Repository variables NEXTAUTH_URL et GOOGLE_CLIENT_ID
NEXTAUTH_URL=https://thezaurus-v2-176686532936.europe-west1.run.app
GOOGLE_CLIENT_ID=176686532936-0uk7jhf88468d1erme78jlqnkl7o8mb8.apps.googleusercontent.com

FIRESTORE_DATABASE_ID=thezaurus-prod
FIRESTORE_COLLECTION_PREFIX=prod
PROFILE_PHOTOS_BUCKET=thezaurus-494709-profile-photos-prod
SECRET_PREFIX=thezaurus
