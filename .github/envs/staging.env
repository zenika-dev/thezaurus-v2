# Configuration de déploiement de l'env staging, lue par _deploy.yml.
# Aucune valeur secrète ici : les secrets sont dans Secret Manager (<SECRET_PREFIX>-*).
# Les noms doivent correspondre à infra/envs/staging/main.tf.

GCP_PROJECT_ID=thezaurus-494709
GCP_REGION=europe-west1
SERVICE_NAME=thezaurus-v2-staging

# Identité de la CI (partagée avec la prod) et identité de l'app
WIF_PROVIDER=projects/176686532936/locations/global/workloadIdentityPools/github-actions-pool/providers/github-actions-oidc
WIF_SERVICE_ACCOUNT=thezurus-sa@thezaurus-494709.iam.gserviceaccount.com
RUNTIME_SERVICE_ACCOUNT=thezurus-runtime-service-accou@thezaurus-494709.iam.gserviceaccount.com

# URL déterministe (output service_url de Terraform)
NEXTAUTH_URL=https://thezaurus-v2-staging-176686532936.europe-west1.run.app
# Même client OAuth que la prod : copier la valeur de la variable GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=176686532936-0uk7jhf88468d1erme78jlqnkl7o8mb8.apps.googleusercontent.com

FIRESTORE_DATABASE_ID=thezaurus-staging
FIRESTORE_COLLECTION_PREFIX=staging
PROFILE_PHOTOS_BUCKET=thezaurus-494709-profile-photos-staging
SECRET_PREFIX=thezaurus-staging
