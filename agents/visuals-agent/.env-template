# =============================================================================
# TheZaurus - Visuals Agent (Quarkus)
# =============================================================================
# Copiez ce fichier en `.env` dans ce répertoire :
#   cp .env-template .env
# Quarkus charge automatiquement le fichier `.env` au démarrage en local.
# =============================================================================

# --- SERVEUR HTTP ---
# Port d'écoute du serveur Quarkus (défaut : 8082)
VISUALS_AGENT_PORT=8082

# --- MODÈLE GEMINI ---
# Nom du modèle Google GenAI utilisé pour la génération d'images (défaut : gemini-4-argon)
GEMINI_MODEL=gemini-4-argon

# Timeout HTTP des appels vers l'API Gemini en millisecondes (défaut : 120000, soit 2 minutes)
GEMINI_TIMEOUT_MS=120000

# --- AUTHENTIFICATION GOOGLE GENAI ---
# Choisir entre l'option 1 (Gemini Developer API) ou l'option 2 (Vertex AI).

# Option 1 : Gemini Developer API (via Google AI Studio)
# Renseigner votre clé d'API obtenue sur https://aistudio.google.com/
GOOGLE_API_KEY=your-gemini-api-key

# Option 2 : Google Cloud Vertex AI
# Pour basculer sur Vertex AI, passer GOOGLE_GENAI_USE_VERTEXAI à true et renseigner le projet GCP.
# L'authentification utilise alors vos Application Default Credentials (gcloud auth application-default login).
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=europe-west1

# --- TEMPLATES DE VISUELS ---
# Répertoire local optionnel pour surcharger les images de templates sans recompiler le projet.
# Si laissé vide, les images intégrées dans src/main/resources/templates/ sont utilisées.
# Ex : /Users/nom/thezaurus-templates ou ./custom-templates
VISUALS_TEMPLATES_DIR=

# --- SERVER-SENT EVENTS (SSE) ---
# Fréquence d'envoi des événements "HEARTBEAT" en millisecondes pendant la génération en streaming (défaut : 3000)
VISUALS_SSE_HEARTBEAT_MS=3000
