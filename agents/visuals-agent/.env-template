# Standalone service; no TheZaurus API or database required.
VISUALS_AGENT_PORT=8087
VISUALS_AGENT_HOST=127.0.0.1
VISUALS_API_KEY=
# Optional JSON client registry; prefer Secret Manager in production.
VISUALS_API_KEYS_JSON=
VISUALS_REQUIRE_API_KEY=false
VISUALS_AI_ENABLED=true
GEMINI_CROP_MODEL=gemini-3.1-flash-lite
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=global
# ADC path, or GOOGLE_API_KEY for Gemini Developer API.
GCLOUD_ADC=
GOOGLE_API_KEY=
