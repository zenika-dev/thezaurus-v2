# Google OAuth Client ID
GOOGLE_CLIENT_ID=your-google-oauth-client-id

# --- CONFIGURATION BASE DE DONNÉES FIRESTORE ---
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
FIRESTORE_DATABASE_ID=thezaurus-dev
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/your-service-account-key.json

# --- MODE DE FONCTIONNEMENT (ÉMULATEUR VS CLOUD GCP) ---
# MODE 1 : Émulateur local (Par défaut)
# - QUARKUS_PROFILE=dev
# - FIRESTORE_EMULATOR_HOST=localhost:9000 (ou firestore:9000 dans docker-compose)
# MODE 2 : Connexion directe à GCP Cloud
# - QUARKUS_PROFILE=prod
# - Commentez FIRESTORE_EMULATOR_HOST
QUARKUS_PROFILE=dev
FIRESTORE_EMULATOR_HOST=localhost:9000

# Préfixe pour les collections de développement/cloud (ex: dev)
FIRESTORE_COLLECTION_PREFIX=dev
